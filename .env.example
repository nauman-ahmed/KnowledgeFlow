# =============================================================================
# KnowledgeFlow — copy to .env at repo root (backend reads via pydantic-settings)
#
# Frontend (Next.js): also link into frontend so Clerk/middleware see keys:
#   ln -sf ../.env frontend/.env.local
# =============================================================================

# --- Database (docker-compose maps host 5433 → container 5432) ---
DATABASE_URL=postgresql+psycopg://knowledgeflow:knowledgeflow@localhost:5433/knowledgeflow

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Neo4j (M7+) — graph storage for GraphRAG ---
# Set NEO4J_ENABLED=true when running docker compose with the neo4j service
NEO4J_ENABLED=false
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=knowledgeflow

# --- Auth (M1+) — https://dashboard.clerk.com ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Clerk URLs (adjust if using custom domains)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/login
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/chat
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/chat
# Optional: set in Clerk Dashboard → Paths → Sign-out URL to /login (redirect_url added in app)

# --- LLM — Qwen / Model Studio compatible API (M2+) ---
# See doc/openai.md
DASHSCOPE_API_KEY=
# Optional fallback if you only have OPENAI_API_KEY set:
# OPENAI_API_KEY=
# Use dashscope-intl for chat + embeddings. Workspace URLs (ws-*.maas.aliyuncs.com) often
# only work for embeddings with workspace keys — see doc/openai.md
OPENAI_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
LLM_CHAT_MODEL=qwen3.6-35b-a3b
LLM_EMBEDDING_MODEL=text-embedding-v4
LLM_EMBEDDING_DIMENSIONS=1536

# --- Observability (M6+) — https://cloud.langfuse.com ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Langfuse SDK uses LANGFUSE_BASE_URL; LANGFUSE_HOST is also accepted
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Deployment (M6+) ---
# Comma-separated allowed origins for CORS (add production Vercel URL)
CORS_ORIGINS=http://localhost:3000
